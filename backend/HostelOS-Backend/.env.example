# ──────────────────────────────────────────────
#  HostelOS Backend — Environment Variables
#  Copy this file to .env and fill in values
# ──────────────────────────────────────────────

# MongoDB connection string
# Local:  mongodb://localhost:27017/hostelos
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/hostelos
MONGO_URI=mongodb://localhost:27017/hostelos

# JWT secret — change this to a long random string in production
JWT_SECRET=hostelos_super_secret_key_change_in_production

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
